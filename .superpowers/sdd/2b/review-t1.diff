+    expect(marketplaceAcp.setPluginEnabled).toHaveBeenCalledWith('demo', false);
+    expect(marketplaceAcp.updatePlugin).toHaveBeenCalledWith('demo');
+    expect(marketplaceAcp.listInstalledPlugins).toHaveBeenCalledTimes(3);
+  });
+});
